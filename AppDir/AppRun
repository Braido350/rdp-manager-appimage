#!/bin/bash
# Ponto de entrada do AppImage. Roda como processo normal do
# usuário (SEM sandbox) — por isso clipboard, copiar/colar de
# arquivos e acesso a qualquer pasta do sistema funcionam de
# forma nativa, igual a qualquer app instalado direto na distro.

HERE="$(dirname "$(readlink -f "${0}")")"

# Guarda o ambiente ORIGINAL do sistema, antes de mexer em PATH e
# LD_LIBRARY_PATH. O app usa isso para rodar um xfreerdp já instalado
# na máquina com as bibliotecas do próprio sistema (e não as
# embutidas aqui, que deixam a conexão mais lenta).
export RDPM_ORIG_PATH="${PATH}"
export RDPM_ORIG_LD_LIBRARY_PATH="${LD_LIBRARY_PATH}"
export RDPM_APPDIR="${HERE}"

# xfreerdp embutido fica no FIM do PATH: só é usado se o sistema não
# tiver FreeRDP instalado. As bibliotecas embutidas continuam
# disponíveis para o próprio app (GTK etc.).
export PATH="${PATH}:${HERE}/usr/bin"
export LD_LIBRARY_PATH="${HERE}/usr/lib:${LD_LIBRARY_PATH}"
export GI_TYPELIB_PATH="${HERE}/usr/lib/girepository-1.0:${GI_TYPELIB_PATH}"
export GSETTINGS_SCHEMA_DIR="${HERE}/usr/share/glib-2.0/schemas:${GSETTINGS_SCHEMA_DIR}"
export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

exec python3 "${HERE}/usr/share/rdp-manager/rdp-manager.py" "$@"
